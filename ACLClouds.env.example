# ACLClouds — переменные окружения (вставить в панель → Startup / Variables)

PY_FILE=start_gateway.py
REQUIREMENTS_FILE=requirements.txt
PY_PACKAGES=discord.py>=2.3.0 requests>=2.31.0 Pillow>=10.0.0 python-dotenv>=1.0.0

# Polling-only (без slash-команд):
# PY_FILE=main.py

# Файл .env должен лежать в /home/container/.env (уже залит через SFTP)
# Скрипт ACLClouds сам делает pip install из REQUIREMENTS_FILE и PY_PACKAGES
# main.py дополнительно ставит deps если pip не сработал
